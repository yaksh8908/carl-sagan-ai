# ============================================================
# CARL SAGAN AI — configuração de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA publique o arquivo .env nem compartilhe suas chaves.
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# Caminho do banco SQLite (relativo à raiz do projeto)
DATABASE_PATH=server/data/carl-sagan.db

# --- Cookies de sessão ---
# auto = Secure somente quando NODE_ENV=production (use HTTPS em produção)
COOKIE_SECURE=auto
# Origens extras confiáveis para requisições com cookie (separadas por vírgula).
# Só é necessário atrás de proxy reverso com host diferente.
TRUSTED_ORIGINS=
# Defina true somente atrás de proxy reverso confiável (usa X-Forwarded-For)
TRUST_PROXY=false

# --- Inteligência artificial ---
# Provedores: anthropic | openai | openai-compatible
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Para openai-compatible (Groq, OpenRouter, Ollama, LM Studio...):
# AI_API_KEY=
# AI_BASE_URL=http://localhost:11434/v1
# AI_REQUIRE_KEY=false   (apenas para servidores locais sem chave)

# Opcional: sobrescreve o modelo padrão do provedor
# (anthropic: claude-haiku-5-5 | openai: gpt-4o-mini)
AI_MODEL=

# Controle de tokens (respostas curtas por padrão)
AI_MAX_TOKENS=300
AI_MAX_TOKENS_LONG=900
AI_TEMPERATURE=0.4
AI_HISTORY_LIMIT=8
AI_TIMEOUT_MS=30000

# Limite de mensagens ao chatbot por usuário, por minuto
CHAT_RATE_LIMIT_PER_MIN=12
