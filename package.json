  "description": "Plataforma de exploração espacial com galáxia 3D interativa e chatbot Carl Sagan AI.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/server.js",
